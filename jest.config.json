{
  "preset": "ts-jest",
  "testEnvironment": "jsdom",
  "extensionsToTreatAsEsm": [".ts", ".tsx"],
  "globals": {
    "ts-jest": {
      "useESM": true,
      "tsconfig": {
        "verbatimModuleSyntax": false
      }
    }
  },
  "setupFilesAfterEnv": ["<rootDir>/tests/setup.ts"],
  "moduleNameMapper": {
    "^~/(.*)$": "<rootDir>/src/$1"
  },
  "testMatch": [
    "<rootDir>/tests/**/*.(test|spec).(ts|tsx)"
  ],
  "collectCoverageFrom": [
    "src/**/*.(ts|tsx)",
    "!src/**/*.d.ts",
    "!src/**/index.ts"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 80,
      "functions": 80,
      "lines": 80,
      "statements": 80
    }
  }
}